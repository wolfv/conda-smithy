{#-
  GitHub Actions workflow for building the feedstock.

  This is a minijinja template. Override it by copying this file to
  `.smithy/templates/github-actions.yml.j2` in your feedstock; add brand
  new workflows as `.smithy/templates/.github__workflows__<name>.yml.j2`.

  Useful context values (see `smithy-core`'s RenderContext for all):
    gha_configs      – matrix entries built on GitHub Actions
    github_actions   – cancel_in_progress / max_parallel / timeout_minutes
    build_tool       – conda-build | rattler-build
    recipe_dir       – usually "recipe"
-#}
# This file was generated automatically by smithy {{ smithy_version }}. Do not edit.
name: Build conda package

on:
{%- for trigger in github_actions.triggers %}
  {{ trigger }}:
{%- endfor %}
{% if github_actions.cancel_in_progress %}
concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}{% endraw %}
  cancel-in-progress: true
{% endif %}
jobs:
  build:
    name: Build {% raw %}${{ matrix.name }}{% endraw %}
    runs-on: {% raw %}${{ matrix.runs_on }}{% endraw %}
    timeout-minutes: {{ github_actions.timeout_minutes }}
    strategy:
      fail-fast: false
      max-parallel: {{ github_actions.max_parallel }}
      matrix:
        include:
{%- for data in gha_configs %}
          - name: {{ data.name }}
            target_platform: {{ data.target_platform }}
            runs_on: {{ data.gha_runs_on[0] }}
            upload: "{{ data.upload }}"
{%- if data.docker_image %}
            docker_image: {{ data.docker_image }}
{%- endif %}
{%- endfor %}
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Setup pixi
        uses: prefix-dev/setup-pixi@v0
        with:
          run-install: false

{%- if build_tool == "rattler-build" %}
      - name: Build recipe
        shell: bash
        run: >-
          pixi exec rattler-build build
          --recipe {{ recipe_dir }}
          --target-platform {% raw %}${{ matrix.target_platform }}{% endraw %}
          -m .ci_support/{% raw %}${{ matrix.name }}{% endraw %}.yaml
{%- else %}
      - name: Build recipe
        shell: bash
        run: >-
          pixi exec --spec conda-build conda build {{ recipe_dir }}
          -m .ci_support/{% raw %}${{ matrix.name }}{% endraw %}.yaml
{%- endif %}

      - name: Upload package
        if: {% raw %}${{ matrix.upload == 'true' && github.event_name == 'push' }}{% endraw %}
{%- if upload_on_branch %} # only from the {{ upload_on_branch }} branch
{%- endif %}
        shell: bash
        env:
          BINSTAR_TOKEN: {% raw %}${{ secrets.BINSTAR_TOKEN }}{% endraw %}
        run: |
          if [[ -n "${BINSTAR_TOKEN}" ]]; then
            pixi exec anaconda -t "${BINSTAR_TOKEN}" upload --force output/**/*.{conda,tar.bz2}
          fi
